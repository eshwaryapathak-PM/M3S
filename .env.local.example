# Copy to .env.local and fill in. .env.local is git-ignored — never commit secrets.

# Supabase — project URL + anon key are safe to expose to the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-ONLY. Never reference from client code.
# Bypasses RLS; only used in trusted server actions / Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for Drizzle (migrations, scripts).
# Use the Supabase "connection pooling" URL (pgbouncer, port 6543) for app traffic,
# and the "direct connection" URL (port 5432) for drizzle-kit migrations.
DATABASE_URL=
